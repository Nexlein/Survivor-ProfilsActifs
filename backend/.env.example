# ==========================================
# PROFILS ACTIFS - ENVIRONMENT CONFIGURATION
# ==========================================

# -------------------------------------
# 1. DATABASE CONFIGURATION (DOCKER)
# -------------------------------------
# Used by docker-compose.yml to initialize the database
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="change_this_password"
POSTGRES_DB="profilsactifs"

# -------------------------------------
# 2. PRISMA CONFIGURATION (NODE)
# -------------------------------------
# Used by Prisma to connect to the database.
# MUST perfectly match the Docker credentials above.
DATABASE_URL="postgresql://postgres:change_this_password@localhost:5432/profilsactifs?schema=public"

# -------------------------------------
# 3. EXPRESS SERVER
# -------------------------------------
PORT=3000
NODE_ENV="development"
FRONTEND_URL="http://localhost:3001"
LOG_LEVEL="info"

# -------------------------------------
# 4. PRODUCT & IT CONSTRAINTS (THOMAS VIGNAL)
# -------------------------------------
FEED_PAGE_SIZE=20
MAX_VIDEO_SIZE_MB=100

# -------------------------------------
# 5. AUTHENTICATION & SECURITY
# -------------------------------------
JWT_SECRET="super-secret-local-key"
JWT_EXPIRES_IN="24h"
BCRYPT_SALT_ROUNDS="10"

# -------------------------------------
# 6. VIDEO ABSTRACTION
# -------------------------------------
# 'local' uses the disk (default)
# 'dummy' simulates PeerTube integration and returns 503 for existing videos (Degraded mode)
VIDEO_PROVIDER="dummy"
