// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  JOB_SEEKER
  RECRUITER
  ADMIN
}

enum VideoType {
  UPLOAD
}

enum VideoStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InteractionType {
  VIEW
  CONTACT
  FAVORITE
  LIKE
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  role         Role
  dateOfBirth  DateTime? // Legal: Age verification (16-18 rules)
  moderationStatus ModerationStatus @default(APPROVED)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  profile      Profile?
  interactions Interaction[] @relation("RecruiterInteractions")
  loginLogs    LoginLog[]
}

model Profile {
  visible Boolean @default(true) // Legal: Hide profiles lacking age verification
  id      String  @id @default(uuid())
  userId  String  @unique
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  fullName     String
  targetSector String?
  location     String?
  avatarUrl    String?
  bio          String?

  // Recruiter specific fields
  companyName String?
  industry    String?
  position    String?

  // JEB Work Permit
  certificationScore    Int?
  hasCertificationBadge Boolean @default(false)

  skills                Skill[]
  videos                Video[]
  interactions          Interaction[]          @relation("ProfileInteractions")
  questionnaireProgress QuestionnaireProgress?
  questionnaireResult   QuestionnaireResult?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([visible, updatedAt(sort: Desc)])
  @@index([userId])
}

model Video {
  id        String  @id @default(uuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  type   VideoType   @default(UPLOAD)
  status VideoStatus @default(PENDING) // Legal: A priori moderation

  // Abstraction Provider
  providerId   String
  providerName String

  // Legal: Consent tracking
  consentDate        DateTime?
  consentTextVersion String?

  // Moderation tracking
  rejectionReason String?
  moderatedById   String?
  moderatedAt     DateTime?

  createdAt    DateTime      @default(now())
  interactions Interaction[]
}

model Skill {
  id       String    @id @default(uuid())
  name     String    @unique
  profiles Profile[]
}

model Interaction {
  id          String @id @default(uuid())
  recruiterId String
  recruiter   User   @relation("RecruiterInteractions", fields: [recruiterId], references: [id], onDelete: Cascade)

  profileId String
  profile   Profile @relation("ProfileInteractions", fields: [profileId], references: [id], onDelete: Cascade)

  videoId String?
  video   Video?  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  type      InteractionType
  message   String? // CONTACT body — the recruiter's message to the candidate
  read      Boolean         @default(false) // Legal/UX: candidate-side notification read state
  createdAt DateTime        @default(now())
}

model LoginLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress String
  createdAt DateTime @default(now())
}

model QuestionnaireProgress {
  id        String  @id @default(uuid())
  profileId String  @unique
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  questionnaireVersion Int @default(1)

  answers     Json
  lastSavedAt DateTime @default(now()) @updatedAt
}

model QuestionnaireResult {
  id        String  @id @default(uuid())
  profileId String  @unique
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  totalScore            Int
  hasCertificationBadge Boolean @default(false)
  questionnaireVersion  Int      @default(1)
  completedAt           DateTime @default(now())
}
