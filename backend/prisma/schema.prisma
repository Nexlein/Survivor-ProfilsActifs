// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  JOB_SEEKER
  RECRUITER
  ADMIN
}

enum VideoType {
  LINK
  UPLOAD
}

enum InteractionType {
  VIEW
  CONTACT
  FAVORITE
  LIKE
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  role         Role
  dateOfBirth  DateTime? // Legal: Age verification (16-18 rules)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  profile      Profile?
  interactions Interaction[] @relation("RecruiterInteractions")
  loginLogs    LoginLog[]
}

model Profile {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  fullName     String
  targetSector String?
  location     String?

  // JEB Work Permit
  certificationScore Int?
  hasWorkPermit      Boolean @default(false)

  skills             Skill[]
  videos             Video[]
  interactions       Interaction[]          @relation("ProfileInteractions")
  questionnaireState QuestionnaireProgress?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Video {
  id        String  @id @default(uuid())
  profileId String
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  type        VideoType @default(LINK)
  url         String
  subtitleUrl String? // Legal: RGAA accessibility
  likes       Int       @default(0) // Product: Determines benefits
  views       Int       @default(0)

  // Legal: Consent tracking
  consentDate        DateTime?
  consentTextVersion String?

  createdAt    DateTime      @default(now())
  interactions Interaction[]
}

model Skill {
  id       String    @id @default(uuid())
  name     String    @unique
  profiles Profile[]
}

model Question {
  id        String   @id @default(uuid())
  text      String
  weighting Int      @default(1)
  options   Option[]
}

model Option {
  id         String   @id @default(uuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  isCorrect  Boolean  @default(false)
}

model Interaction {
  id          String @id @default(uuid())
  recruiterId String
  recruiter   User   @relation("RecruiterInteractions", fields: [recruiterId], references: [id])

  profileId String
  profile   Profile @relation("ProfileInteractions", fields: [profileId], references: [id], onDelete: Cascade)

  videoId String?
  video   Video?  @relation(fields: [videoId], references: [id], onDelete: Cascade)

  type      InteractionType
  createdAt DateTime        @default(now())
}

model LoginLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress String
  createdAt DateTime @default(now())
}

model QuestionnaireProgress {
  id        String  @id @default(uuid())
  profileId String  @unique
  profile   Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  answers     Json
  lastSavedAt DateTime @updatedAt
}
